# Tracking Service Local Environment Configuration
PORT=4004

# Dedicated Neon PostgreSQL Database for Tracking Service:
TRACKING_DB_USER=neondb_owner
TRACKING_DB_PASSWORD=
TRACKING_DB_URL=jdbc:postgresql://your-neon-endpoint-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channelBinding=require
TRACKING_MIGRATION_DB_URL=jdbc:postgresql://your-neon-endpoint.us-east-2.aws.neon.tech/neondb?sslmode=require&channelBinding=require

# Direct Spring Boot / Flyway properties:
spring.datasource.username=neondb_owner
spring.datasource.password=
spring.datasource.url=jdbc:postgresql://your-neon-endpoint-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channelBinding=require
spring.flyway.user=neondb_owner
spring.flyway.password=
spring.flyway.url=jdbc:postgresql://your-neon-endpoint.us-east-2.aws.neon.tech/neondb?sslmode=require&channelBinding=require

# Redis Cache configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
TRACKING_CACHE_TTL=60

# Frontend origin for CORS
FRONTEND_URL=http://localhost:3000

# Google Gemini API (Bonus marks)
# Get a free key at: https://aistudio.google.com/app/apikey
# If left blank, an intelligent built-in rule engine handles all answers!
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
